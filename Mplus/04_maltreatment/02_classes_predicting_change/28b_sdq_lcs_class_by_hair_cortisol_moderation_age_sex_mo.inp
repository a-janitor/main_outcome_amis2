TITLE:
  M28b: Maltreatment-class differences in baseline psychopathology and latent
  change moderated by standardized proximal-segment hair cortisol adjusted for
  baseline age and sex;

DATA:
  FILE = AMIS_mplus_dataset_m18_ses_mo.dat;

VARIABLE:
  NAMES =
    has_sdq has_mt has_cg has_diag diag_vor int_vor ext_vor int_ext aff_vor anx_vor
    psy_vor vh_vor adhs_vor weit_vor abh_vor ess_vor tic_vor enur_vor enk_vor anp_vor
    ptbs_vor bipo_vor md_vor dys_vor pan_vor gad_vor ago_vor soz_vor phob_vor zwa_vor
    trn_vor cd_vor odd_vor dnos_vor bind_vor mut_vor sext5 age_b2 age_k2 age_p2 age_t2
    age_b5 age_k5 age_p5 age_t5 emo_b2 emo_b5 emo_k2 emo_k5 emo_p2 emo_p5 emo_t2 emo_t5
    con_b2 con_b5 con_k2 con_k5 con_p2 con_p5 con_t2 con_t5 hyp_b2 hyp_b5 hyp_k2 hyp_k5
    hyp_p2 hyp_p5 hyp_t2 hyp_t5 pee_b2 pee_b5 pee_k2 pee_k5 pee_p2 pee_p5 pee_t2 pee_t5
    pro_b2 pro_b5 pro_k2 pro_k5 pro_p2 pro_p5 pro_t2 pro_t5 mt_sdq5 mt_covag n6_sa n5_sa
    nev_sa sev_sa fq_sa z6_sa z5_sa zev_sa zsv_sa zfq_sa zind_sa n6_kk n5_kk nev_kk
    sev_kk fq_kk z6_kk z5_kk zev_kk zsv_kk zfq_kk zind_kk n6_vsa n5_vsa nev_vsa sev_vsa
    fq_vsa z6_vsa z5_vsa zev_vsa zsv_vsa zfq_vsa zind_vsa n6_fsz n5_fsz nev_fsz sev_fsz
    fq_fsz z6_fsz z5_fsz zev_fsz zsv_fsz zfq_fsz zind_fsz n6_ssz n5_ssz nev_ssz sev_ssz
    fq_ssz z6_ssz z5_ssz zev_ssz zsv_ssz zfq_ssz zind_ssz n6_ja n5_ja nev_ja sev_ja
    fq_ja z6_ja z5_ja zev_ja zsv_ja zfq_ja zind_ja n6_jea n5_jea nev_jea sev_jea fq_jea
    z6_jea z5_jea zev_jea zsv_jea zfq_jea zind_jea mal_t1 n6_t1 n5_t1 nev_t1 sev_t1
    fq_t1 chr_t1 nexp_t1 ncov_t1 mal_t12 n6_t12 n5_t12 nev_t12 sev_t12 fq_t12 chr_t12
    nexp_t12 ncov_t12 mal_all n6_all n5_all nev_all sev_all fq_all chr_all nexp_all
    ncov_all c6_t1 c5_t1 cev_t1 csv_t1 cfq_t1 cch_t1 c6_t12 c5_t12 cev_t12 csv_t12
    cfq_t12 cch_t12 c6_all c5_all cev_all csv_all cfq_all cch_all d1a_s1 d1a_n1 d1a_e1
    d1a_v1 d1a_c1 d1a_x1 d1a_p1 d1n_s1 d1n_n1 d1n_e1 d1n_v1 d1n_c1 d1n_x1 d1n_p1 d2a_s1
    d2a_n1 d2a_e1 d2a_v1 d2a_c1 d2a_x1 d2a_p1 d2n_s1 d2n_n1 d2n_e1 d2n_v1 d2n_c1 d2n_x1
    d2n_p1 d2e_s1 d2e_n1 d2e_e1 d2e_v1 d2e_c1 d2e_x1 d2e_p1 d1a_s2 d1a_n2 d1a_e2 d1a_v2
    d1a_c2 d1a_x2 d1a_p2 d1n_s2 d1n_n2 d1n_e2 d1n_v2 d1n_c2 d1n_x2 d1n_p2 d2a_s2 d2a_n2
    d2a_e2 d2a_v2 d2a_c2 d2a_x2 d2a_p2 d2n_s2 d2n_n2 d2n_e2 d2n_v2 d2n_c2 d2n_x2 d2n_p2
    d2e_s2 d2e_n2 d2e_e2 d2e_v2 d2e_c2 d2e_x2 d2e_p2 d1a_sa d1a_na d1a_ea d1a_va d1a_ca
    d1a_xa d1a_pa d1n_sa d1n_na d1n_ea d1n_va d1n_ca d1n_xa d1n_pa d2a_sa d2a_na d2a_ea
    d2a_va d2a_ca d2a_xa d2a_pa d2n_sa d2n_na d2n_ea d2n_va d2n_ca d2n_xa d2n_pa d2e_sa
    d2e_na d2e_ea d2e_va d2e_ca d2e_xa d2e_pa km_e1 km_v1 km_c1 km_x1 km_p1 sm_e1 sm_v1
    sm_c1 sm_x1 sm_p1 ea_e1 ea_v1 ea_c1 ea_x1 ea_p1 en_e1 en_v1 en_c1 en_x1 en_p1 em_e1
    em_v1 em_c1 em_x1 em_p1 mv_e1 mv_v1 mv_c1 mv_x1 mv_p1 mb_e1 mb_v1 mb_c1 mb_x1 mb_p1
    bm_e1 bm_v1 bm_c1 bm_x1 bm_p1 mre_e1 mre_v1 mre_c1 mre_x1 mre_p1 mrbm_e1 mrbm_v1
    mrbm_c1 mrbm_x1 mrbm_p1 km_e2 km_v2 km_c2 km_x2 km_p2 sm_e2 sm_v2 sm_c2 sm_x2 sm_p2
    ea_e2 ea_v2 ea_c2 ea_x2 ea_p2 en_e2 en_v2 en_c2 en_x2 en_p2 em_e2 em_v2 em_c2 em_x2
    em_p2 mv_e2 mv_v2 mv_c2 mv_x2 mv_p2 mb_e2 mb_v2 mb_c2 mb_x2 mb_p2 bm_e2 bm_v2 bm_c2
    bm_x2 bm_p2 mre_e2 mre_v2 mre_c2 mre_x2 mre_p2 mrbm_e2 mrbm_v2 mrbm_c2 mrbm_x2
    mrbm_p2 km_ea km_va km_ca km_xa km_pa sm_ea sm_va sm_ca sm_xa sm_pa ea_ea ea_va
    ea_ca ea_xa ea_pa en_ea en_va en_ca en_xa en_pa em_ea em_va em_ca em_xa em_pa mv_ea
    mv_va mv_ca mv_xa mv_pa mb_ea mb_va mb_ca mb_xa mb_pa bm_ea bm_va bm_ca bm_xa bm_pa
    mre_ea mre_va mre_ca mre_xa mre_pa mrbm_ea mrbm_va mrbm_ca mrbm_xa mrbm_pa km_s1
    sm_s1 ea_s1 en_s1 em_s1 mv_s1 mb_s1 bm_s1 mre_s1 mrbm_s1 km_s2 sm_s2 ea_s2 en_s2
    em_s2 mv_s2 mb_s2 bm_s2 mre_s2 mrbm_s2 km_sa sm_sa ea_sa en_sa em_sa mv_sa mb_sa
    bm_sa mre_sa mrbm_sa c2p1raw c2p2raw c2p3raw c2p1log c2p2log c2p3log c2p1_z c2p2_z
    c2p3_z c5_raw c5_log c5_z prs_e02 prs_e04 prs_e06 prs_eau prs_m02 prs_m04 prs_m06
    prs_mau PC1 PC2 PC3 PC4 stat_t5 aget2 aget5m SIC_N mo_cls mo_p1 mo_p2 mo_p3 mo_p4
    mo_pmx sesausb
    ;

  USEVARIABLES =
    hyp_b2 hyp_k2 hyp_p2 hyp_b5 hyp_k5 hyp_p5 con_b2 con_k2 con_p2 con_b5 con_k5 con_p5
    emo_b2 emo_k2 emo_p2 emo_b5 emo_k5 emo_p5 aget2 sext5 c2p1_z c2 c3 c4 i2hcc i3hcc
    i4hcc
    ;

  USEOBSERVATIONS =
    (stat_t5 NE 0) AND
    (mo_cls GE 1) AND
    (mo_cls LE 4);

  IDVARIABLE = SIC_N;

  MISSING = ALL (-999);

DEFINE:

  c2 = 0;
  c3 = 0;
  c4 = 0;

  IF (mo_cls EQ 2) THEN c2 = 1;
  IF (mo_cls EQ 3) THEN c3 = 1;
  IF (mo_cls EQ 4) THEN c4 = 1;

  CENTER
    aget2 sext5 c2p1_z
    (GRANDMEAN);

  ! Class-by-moderator interaction terms

  i2hcc = c2 * c2p1_z;
  i3hcc = c3 * c2p1_z;
  i4hcc = c4 * c2p1_z;


ANALYSIS:
  ESTIMATOR = MLR;
  COVERAGE = 0.01;

MODEL:

  ! Equal factor loadings across T2 and T5

  EXT2 BY
    hyp_b2@1
    hyp_k2 (ex2)
    hyp_p2 (ex3)
    con_b2 (ex4)
    con_k2 (ex5)
    con_p2 (ex6);

  EXT5 BY
    hyp_b5@1
    hyp_k5 (ex2)
    hyp_p5 (ex3)
    con_b5 (ex4)
    con_k5 (ex5)
    con_p5 (ex6);

  EMO2 BY
    emo_b2@1
    emo_k2 (em2)
    emo_p2 (em3);

  EMO5 BY
    emo_b5@1
    emo_k5 (em2)
    emo_p5 (em3);

  ! Residual covariances of identical indicators over time

  hyp_b2 WITH hyp_b5;
  hyp_k2 WITH hyp_k5;
  hyp_p2 WITH hyp_p5;
  con_b2 WITH con_b5;
  con_k2 WITH con_k5;
  con_p2 WITH con_p5;
  emo_b2 WITH emo_b5;
  emo_k2 WITH emo_k5;
  emo_p2 WITH emo_p5;

  ! Within-informant residual covariances
  ! constrained equal across T2 and T5

  hyp_b2 WITH con_b2 (w_b_hc);
  hyp_b2 WITH emo_b2 (w_b_he);
  con_b2 WITH emo_b2 (w_b_ce);

  hyp_b5 WITH con_b5 (w_b_hc);
  hyp_b5 WITH emo_b5 (w_b_he);
  con_b5 WITH emo_b5 (w_b_ce);

  hyp_k2 WITH con_k2 (w_k_hc);
  hyp_k2 WITH emo_k2 (w_k_he);
  con_k2 WITH emo_k2 (w_k_ce);

  hyp_k5 WITH con_k5 (w_k_hc);
  hyp_k5 WITH emo_k5 (w_k_he);
  con_k5 WITH emo_k5 (w_k_ce);

  hyp_p2 WITH con_p2 (w_p_hc);
  hyp_p2 WITH emo_p2 (w_p_he);
  con_p2 WITH emo_p2 (w_p_ce);

  hyp_p5 WITH con_p5 (w_p_hc);
  hyp_p5 WITH emo_p5 (w_p_he);
  con_p5 WITH emo_p5 (w_p_ce);

  ! Selected between-informant residual covariances for b and p,
  ! constrained equal across T2 and T5

  hyp_b2 WITH hyp_p2 (bi_hyp);
  hyp_b2 WITH con_p2 (bi_bphc);
  hyp_p2 WITH con_b2 (bi_pbhc);
  con_b2 WITH con_p2 (bi_con);
  emo_b2 WITH emo_p2 (bi_emo);

  hyp_b5 WITH hyp_p5 (bi_hyp);
  hyp_b5 WITH con_p5 (bi_bphc);
  hyp_p5 WITH con_b5 (bi_pbhc);
  con_b5 WITH con_p5 (bi_con);
  emo_b5 WITH emo_p5 (bi_emo);

  ! Partial scalar invariance:
  ! equal indicator intercepts except for emo_k

  [hyp_b2 hyp_b5] (ihb);
  [hyp_k2 hyp_k5] (ihk);
  [hyp_p2 hyp_p5] (ihp);

  [con_b2 con_b5] (icb);
  [con_k2 con_k5] (ick);
  [con_p2 con_p5] (icp);

  [emo_b2 emo_b5] (ieb);
  [emo_p2 emo_p5] (iep);

  [emo_k2] (iek2);
  [emo_k5] (iek5);


  ! Classical two-wave latent change score model

  ! Externalizing change

  d_ext BY EXT5@1;

  EXT5 ON EXT2@1;

  EXT5@0;
  [EXT5@0];

  ! Emotional-problems change

  d_emo BY EMO5@1;

  EMO5 ON EMO2@1;

  EMO5@0;
  [EMO5@0];

  ! Baseline latent means fixed for factor identification

  [EXT2@0];
  [EMO2@0];

  ! Latent change intercepts in the reference class

  [d_ext] (m_dext);
  [d_emo] (m_demo);

  ! Baseline and latent-change residual variances

  EXT2;
  EMO2;

  d_ext;
  d_emo;

  ! Covariance between baseline levels

  EXT2 WITH EMO2;

  ! Covariances between baseline levels and latent changes

  EXT2 WITH d_ext;
  EXT2 WITH d_emo;

  EMO2 WITH d_ext;
  EMO2 WITH d_emo;

  ! Covariance between latent changes

  d_ext WITH d_emo;


  ! Class effects on T2 baseline levels

  EXT2 ON c2 (e2_c2);
  EXT2 ON c3 (e2_c3);
  EXT2 ON c4 (e2_c4);

  EMO2 ON c2 (m2_c2);
  EMO2 ON c3 (m2_c3);
  EMO2 ON c4 (m2_c4);

  ! Class effects on latent change

  d_ext ON c2 (dx_c2);
  d_ext ON c3 (dx_c3);
  d_ext ON c4 (dx_c4);

  d_emo ON c2 (dm_c2);
  d_emo ON c3 (dm_c3);
  d_emo ON c4 (dm_c4);


  ! Effects of covariates on baseline and change

  EXT2 EMO2 d_ext d_emo ON
    aget2 sext5;

  ! Moderator main effects on baseline and change

  EXT2 ON c2p1_z (bex_mod);
  EMO2 ON c2p1_z (bem_mod);
  d_ext ON c2p1_z (bdx_mod);
  d_emo ON c2p1_z (bdm_mod);

  ! Class-by-moderator interactions on baseline levels

  EXT2 ON i2hcc (exi2);
  EXT2 ON i3hcc (exi3);
  EXT2 ON i4hcc (exi4);

  EMO2 ON i2hcc (emi2);
  EMO2 ON i3hcc (emi3);
  EMO2 ON i4hcc (emi4);

  ! Class-by-moderator interactions on latent change

  d_ext ON i2hcc (dxi2);
  d_ext ON i3hcc (dxi3);
  d_ext ON i4hcc (dxi4);

  d_emo ON i2hcc (dmi2);
  d_emo ON i3hcc (dmi3);
  d_emo ON i4hcc (dmi4);



MODEL CONSTRAINT:

  NEW(
    ex2_c1 ex2_c2 ex2_c3 ex2_c4
    ex5_c1 ex5_c2 ex5_c3 ex5_c4
    em2_c1 em2_c2 em2_c3 em2_c4
    em5_c1 em5_c2 em5_c3 em5_c4

    dex_c1 dex_c2 dex_c3 dex_c4
    dem_c1 dem_c2 dem_c3 dem_c4

    dx_2v1 dx_3v1 dx_4v1
    dx_3v2 dx_4v2 dx_4v3

    dm_2v1 dm_3v1 dm_4v1
    dm_3v2 dm_4v2 dm_4v3

    sbe_c1 sbe_c2 sbe_c3 sbe_c4
    sbm_c1 sbm_c2 sbm_c3 sbm_c4
    sdx_c1 sdx_c2 sdx_c3 sdx_c4
    sdm_c1 sdm_c2 sdm_c3 sdm_c4

    ibe_2v1 ibe_3v1 ibe_4v1
    ibe_3v2 ibe_4v2 ibe_4v3
    ibm_2v1 ibm_3v1 ibm_4v1
    ibm_3v2 ibm_4v2 ibm_4v3

    idx_2v1 idx_3v1 idx_4v1
    idx_3v2 idx_4v2 idx_4v3
    idm_2v1 idm_3v1 idm_4v1
    idm_3v2 idm_4v2 idm_4v3
  );

  ! Class-specific latent levels at T2

  ex2_c1 = 0;
  ex2_c2 = e2_c2;
  ex2_c3 = e2_c3;
  ex2_c4 = e2_c4;

  em2_c1 = 0;
  em2_c2 = m2_c2;
  em2_c3 = m2_c3;
  em2_c4 = m2_c4;

  ! Class-specific latent levels at T5

  ex5_c1 = m_dext;
  ex5_c2 = e2_c2 + m_dext + dx_c2;
  ex5_c3 = e2_c3 + m_dext + dx_c3;
  ex5_c4 = e2_c4 + m_dext + dx_c4;

  em5_c1 = m_demo;
  em5_c2 = m2_c2 + m_demo + dm_c2;
  em5_c3 = m2_c3 + m_demo + dm_c3;
  em5_c4 = m2_c4 + m_demo + dm_c4;

  ! Class-specific latent changes

  dex_c1 = m_dext;
  dex_c2 = m_dext + dx_c2;
  dex_c3 = m_dext + dx_c3;
  dex_c4 = m_dext + dx_c4;

  dem_c1 = m_demo;
  dem_c2 = m_demo + dm_c2;
  dem_c3 = m_demo + dm_c3;
  dem_c4 = m_demo + dm_c4;

  ! Pairwise class contrasts: externalizing change

  dx_2v1 = dx_c2;
  dx_3v1 = dx_c3;
  dx_4v1 = dx_c4;

  dx_3v2 = dx_c3 - dx_c2;
  dx_4v2 = dx_c4 - dx_c2;
  dx_4v3 = dx_c4 - dx_c3;

  ! Pairwise class contrasts: emotional-problems change

  dm_2v1 = dm_c2;
  dm_3v1 = dm_c3;
  dm_4v1 = dm_c4;

  dm_3v2 = dm_c3 - dm_c2;
  dm_4v2 = dm_c4 - dm_c2;
  dm_4v3 = dm_c4 - dm_c3;

  ! Class-specific moderator effects on baseline externalizing

  sbe_c1 = bex_mod;
  sbe_c2 = bex_mod + exi2;
  sbe_c3 = bex_mod + exi3;
  sbe_c4 = bex_mod + exi4;

  ! Class-specific moderator effects on baseline emotional problems

  sbm_c1 = bem_mod;
  sbm_c2 = bem_mod + emi2;
  sbm_c3 = bem_mod + emi3;
  sbm_c4 = bem_mod + emi4;

  ! Class-specific moderator effects on externalizing change

  sdx_c1 = bdx_mod;
  sdx_c2 = bdx_mod + dxi2;
  sdx_c3 = bdx_mod + dxi3;
  sdx_c4 = bdx_mod + dxi4;

  ! Class-specific moderator effects on emotional change

  sdm_c1 = bdm_mod;
  sdm_c2 = bdm_mod + dmi2;
  sdm_c3 = bdm_mod + dmi3;
  sdm_c4 = bdm_mod + dmi4;

  ! Pairwise differences in baseline externalizing moderation

  ibe_2v1 = exi2;
  ibe_3v1 = exi3;
  ibe_4v1 = exi4;
  ibe_3v2 = exi3 - exi2;
  ibe_4v2 = exi4 - exi2;
  ibe_4v3 = exi4 - exi3;

  ! Pairwise differences in baseline emotional moderation

  ibm_2v1 = emi2;
  ibm_3v1 = emi3;
  ibm_4v1 = emi4;
  ibm_3v2 = emi3 - emi2;
  ibm_4v2 = emi4 - emi2;
  ibm_4v3 = emi4 - emi3;

  ! Pairwise differences in externalizing-change moderation

  idx_2v1 = dxi2;
  idx_3v1 = dxi3;
  idx_4v1 = dxi4;
  idx_3v2 = dxi3 - dxi2;
  idx_4v2 = dxi4 - dxi2;
  idx_4v3 = dxi4 - dxi3;

  ! Pairwise differences in emotional-change moderation

  idm_2v1 = dmi2;
  idm_3v1 = dmi3;
  idm_4v1 = dmi4;
  idm_3v2 = dmi3 - dmi2;
  idm_4v2 = dmi4 - dmi2;
  idm_4v3 = dmi4 - dmi3;



MODEL TEST:

  ! Joint 12-degree-of-freedom moderation test

  0 = exi2;
  0 = exi3;
  0 = exi4;
  0 = emi2;
  0 = emi3;
  0 = emi4;
  0 = dxi2;
  0 = dxi3;
  0 = dxi4;
  0 = dmi2;
  0 = dmi3;
  0 = dmi4;


OUTPUT:
  SAMPSTAT
  STANDARDIZED
  CINTERVAL
  TECH1
  TECH3
  TECH4;

