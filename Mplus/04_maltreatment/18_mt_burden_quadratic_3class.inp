  USEOBSERVATIONS ARE mal_all EQ 1;

  MISSING ARE ALL (-999);
  IDVARIABLE IS SIC_N;
  CLASSES = c(3);

ANALYSIS:
  TYPE = MIXTURE;
  ESTIMATOR = MLR;
  STARTS = 0;
  OPTSEED = 930781;
  PROCESSORS = 4;

MODEL:
  %OVERALL%

  ! Quadratic growth process for maltreatment burden
  bur_i bur_s bur_q |
    zind_sa@-3.133398
    zind_kk@-2.633398
    zind_vsa@-1.800065
    zind_fsz@-0.966732
    zind_ssz@0.199935
    zind_ja@1.866602
    zind_jea@3.133398;

  ! Growth-factor variances constrained equal across classes
  bur_i bur_s bur_q;

  ! Growth-factor covariances constrained equal across classes
  bur_i WITH bur_s;
  bur_i WITH bur_q;
  bur_s WITH bur_q;

  ! Residual variances constrained equal across classes
  zind_sa zind_kk zind_vsa zind_fsz zind_ssz zind_ja zind_jea;

  ! Class-specific growth-factor means
  %c#1%
  [bur_i] (bi1);
  [bur_s] (bs1);
  [bur_q] (bq1);

  %c#2%
  [bur_i] (bi2);
  [bur_s] (bs2);
  [bur_q] (bq2);

  %c#3%
  [bur_i] (bi3);
  [bur_s] (bs3);
  [bur_q] (bq3);

